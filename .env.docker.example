# Docker Compose >= 2.30. Copy to .env.docker; do not commit that file.
# Raw key=value format: no surrounding quotes, substitutions or inline comments.
# Keep all SQLite files inside the mounted directory.
CQA_DATABASE_PATH=/var/lib/replimetr/cqa.sqlite3
CQA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CQA_ORGANIZER_API_URL=
CQA_EVALUATION_TIMEOUT=180
CQA_DATABASE_TIMEOUT=15
CQA_AI_CONCURRENCY=2
CQA_BATCH_QUEUE_LIMIT=1000
# Optional container path, NOT a path on your Windows/Linux host.
CQA_TARIFFS_PATH=
# Optional Gemini adapter. No key means AI_NOT_CONFIGURED; manual API still works.
GEMINI_API_KEY=
CQA_GEMINI_MODEL=gemini-3.6-flash
CQA_GEMINI_FALLBACK_MODEL=
CQA_GEMINI_PRIMARY_TIMEOUT_SECONDS=15
CQA_GEMINI_FALLBACK_TIMEOUT_SECONDS=40
CQA_GEMINI_THINKING_LEVEL=low
CQA_GEMINI_ALLOW_VOICE_CALLS=0
