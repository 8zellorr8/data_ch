CQA_DATABASE_PATH=data/cqa.sqlite3
CQA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Полная подписанная GET-ссылка организаторов. Не публиковать в Git.
CQA_ORGANIZER_API_URL=
CQA_EVALUATION_TIMEOUT=240
CQA_DATABASE_TIMEOUT=15
CQA_AI_CONCURRENCY=1
CQA_BATCH_QUEUE_LIMIT=1000
# Automatic retries after a known 429 refusal, excluding the first attempt (0-10).
CQA_BATCH_RATE_RETRIES=3
# Optional JSON file with explicit model tariffs; empty means unknown cost.
CQA_TARIFFS_PATH=
# Gemini API evaluator: ключ хранить только в локальном .env.
GEMINI_API_KEY=
CQA_GEMINI_MODEL=gemini-3.5-flash-lite
# Empty: retry the same model; the Flash models have only 20 RPD in this project.
CQA_GEMINI_FALLBACK_MODEL=
CQA_GEMINI_PRIMARY_TIMEOUT_SECONDS=15
CQA_GEMINI_FALLBACK_TIMEOUT_SECONDS=40
CQA_GEMINI_THINKING_LEVEL=medium
# Sends transcripts only; the team approved DEV processing.
CQA_GEMINI_ALLOW_VOICE_CALLS=1
# Pace every model request, including adapter retries. Check your project's quota.
CQA_GEMINI_RPM=3

# Primary provider for the integrated application; add its key locally.
CQA_AI_PROVIDER=openai-compatible

# Local QLoRA: requires CUDA, base weights and the separately delivered adapter.
# Optional: switch CQA_AI_PROVIDER to local-http or local-lora explicitly.
CQA_LOCAL_AI_URL=http://127.0.0.1:8002
# Separate inference-worker key, not aijuju. Keep it outside Git.
CQA_LOCAL_AI_KEY=
CQA_LOCAL_AI_TIMEOUT_SECONDS=210
CQA_LORA_ADAPTER=data/lora/qwen3-4b-cqa/adapter
CQA_LORA_DEVICE=cuda
CQA_LORA_MAX_NEW_TOKENS=1280
CQA_LORA_TIMEOUT_SECONDS=180
CQA_KEEP_AWAKE=1

# Paid provider is disabled. Explicit opt-in is required to enable it.
CQA_LLM_API_ENABLED=0
CQA_LLM_API_KEY=
CQA_LLM_BASE_URL=https://api.aijuju.rest/v1
CQA_LLM_MODEL=gemini-3.8-flash
CQA_LLM_MODEL_ALIASES=combo/gemini-3-8-flash
CQA_LLM_ALLOW_VOICE_CALLS=1
CQA_LLM_MAX_ATTEMPTS=1
CQA_LLM_RPM=15
CQA_LLM_MAX_OUTPUT_TOKENS=4096
CQA_LLM_TIMEOUT_SECONDS=75
# Local usage ledger, not a provider-side billing cap. Start with reported spending.
CQA_LLM_TOKEN_BUDGET=7000000
CQA_LLM_INITIAL_SPENT=809000
# Reserve includes a 191k buffer: new ordinary API tests can use at most 1M.
CQA_LLM_TOKEN_RESERVE=5191000
CQA_LLM_USE_JURY_RESERVE=0
CQA_LLM_BUDGET_PATH=data/aijuju-jury-budget.sqlite3
